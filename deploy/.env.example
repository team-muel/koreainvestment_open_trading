# ═══════════════════════════════════════════════════
#  KIS ICT 트레이딩 시스템 환경변수 템플릿
#  실제 사용 시 이 파일을 .env로 복사하고 값을 채우세요
#  절대 .env를 git에 커밋하지 마세요!
# ═══════════════════════════════════════════════════

# ── 한국투자증권 API ──────────────────────────────────
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=your_account_number
KIS_PAPER_APP_KEY=your_paper_app_key_here
KIS_PAPER_APP_SECRET=your_paper_app_secret_here
KIS_PAPER_ACCOUNT_NO=your_paper_account_number
KIS_MODE=vps

# ── Supabase ─────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_service_role_key_here

# ── Telegram ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# ── Notion ───────────────────────────────────────────
NOTION_TOKEN=your_notion_integration_token
NOTION_TRADE_JOURNAL_DB_ID=your_trade_journal_db_id
NOTION_PREMARKET_DB_ID=your_premarket_db_id
NOTION_DAILY_REPORT_DB_ID=your_daily_report_db_id

# ── Google Calendar (선택) ───────────────────────────
GOOGLE_OAUTH_CLIENT_JSON=/app/config/gcal_client.json
GOOGLE_TOKEN_JSON=/app/config/gcal_token.json
GOOGLE_CALENDAR_ID=your_calendar_id@gmail.com

# ── 트레이딩 설정 ─────────────────────────────────────
LIVE_TRADING_ENABLED=false
LOG_LEVEL=INFO
