# Copy to .env on the VPS and adjust paths.
TZ=Asia/Seoul
COMPOSE_PROJECT_NAME=kis_ict

# Bind services to localhost by default. Put a reverse proxy/VPN in front if remote access is needed.
BACKEND_HOST=127.0.0.1
FRONTEND_HOST=127.0.0.1

# Directory containing kis_devlp.yaml and daily KIS token files on the VPS.
# Example: /home/ubuntu/KIS/config
KIS_CONFIG_DIR=/home/ubuntu/KIS/config

# Optional Notion integration. Create an internal Notion integration, share the
# ICT Daily Reports database with it, then set these values on the VPS.
NOTION_TOKEN=
NOTION_DAILY_REPORTS_DB_ID=

# Optional metadata for a future server-side Google Calendar integration.
# A Google Calendar API key alone cannot write events to a private calendar;
# private calendar writes require OAuth or a service account with delegated access.
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_ID=primary
