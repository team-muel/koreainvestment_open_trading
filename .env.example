# Copy to .env on the VPS and adjust paths.
TZ=Asia/Seoul
COMPOSE_PROJECT_NAME=kis_ict

# Bind services to localhost by default. Put a reverse proxy/VPN in front if remote access is needed.
BACKEND_HOST=127.0.0.1
FRONTEND_HOST=127.0.0.1

# Directory containing kis_devlp.yaml and daily KIS token files on the VPS.
# Example: /home/ubuntu/KIS/config
KIS_CONFIG_DIR=/home/ubuntu/KIS/config

# Optional Notion integration. Create an internal Notion integration, share the
# ICT Daily Reports database with it, then set these values on the VPS.
NOTION_TOKEN=
NOTION_DAILY_REPORTS_DB_ID=

# Google Calendar integration (OAuth 2.0 installed-app client).
# Setup:
#   1. GCP Console → API 및 서비스 → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID 생성
#      (유형: 데스크톱 앱) → JSON 다운로드
#   2. 로컬 PC에서 최초 1회 실행:
#        python scripts/authorize_gcal.py --client /path/to/client_secret.json
#      브라우저에서 승인 → gcal_token.json 생성
#   3. client_secret.json 과 gcal_token.json 을 VPS 에 업로드
#   4. 아래 경로를 실제 VPS 경로로 수정
GOOGLE_OAUTH_CLIENT_JSON=/opt/kis-ict/secrets/client_secret.json
GOOGLE_TOKEN_JSON=/opt/kis-ict/secrets/gcal_token.json
GOOGLE_CALENDAR_ID=your-email@gmail.com
